{
  "source": "Derived from spec/behavior.md, Media subscribing (issue #303). Each sequence drives one frame sequencer over a playout clock with default options whose time source reads the step's at. A step may anchor the clock (due(anchor) from idle), report audio, reset the clock as another track would (clockReset), deliver an object [group, object, timestamp] with the timestamp as its LOC Timestamp property and no Timescale (null: no timestamp), end or reset a group, restart, poll (the frames as [group, object, discontinuity?] and waitUs, null when undefined), and check stats and the clock's target latency. Objects are normal status with an empty payload. grouping defaults to keyframe",
  "sequences": [
    {
      "name": "in order: frames go out at once, with nothing to wait for",
      "steps": [
        { "at": "0", "object": ["0", "0", "10000000"] },
        { "at": "0", "object": ["0", "9", null] },
        { "at": "0", "poll": { "frames": [["0", "0"]], "waitUs": "50000" } },
        { "at": "0", "anchor": "10000000" },
        { "at": "33333", "object": ["0", "1", "10033333"] },
        { "at": "33333", "object": ["0", "2", "10066666"] },
        { "at": "33333", "poll": { "frames": [["0", "1"], ["0", "2"]], "waitUs": null } },
        { "at": "40000", "groupEnd": "0" },
        { "at": "1000000", "object": ["1", "0", "11000000"] },
        { "at": "1000000", "poll": { "frames": [["1", "0"]], "waitUs": null } },
        { "at": "1000000", "stats": { "delivered": "4", "late": "0", "skippedGroups": "0", "resyncs": "0", "untimed": "1" }, "targetLatency": "2000000" }
      ]
    },
