{
  "source": "Derived from spec/media-layer.md, Shared timeline and playout clock (issues #285 and #290); boundary cases follow its tables. epochOrigins follow its Media Timeline track section (issue #291): systemClockMs is the system clock (Date.now(), time.time_ns()) when the clock is created, and createdAt the source time then. Timeline vectors give originEpochUs, so their timestamps are Unix-epoch microseconds. A source timeline's captureLatencyUs is its initial capture latency, and a captureLatency step changes it; captureLatencyErrors must be rejected both at creation and when set. A playout targetLatency step reads the clock's target latency and a keyframeInterval step reports one keyframe interval; playoutErrors options and keyframeIntervalErrors must be rejected",
  "broadcast": [
    {
      "name": "the origin defaults to the source time at creation; a time before it still maps onto the epoch",
      "createdAt": "5000000",
      "originEpochUs": "1759924158381000",
      "steps": [
        { "at": "5000000", "now": "1759924158381000" },
        { "at": "5033333", "now": "1759924158414333" },
        { "at": "5033333", "fromSource": "5100000", "expect": "1759924158481000" },
        { "at": "5033333", "fromSource": "4999000", "expect": "1759924158380000" }
      ]
    },
    {
      "name": "an explicit origin is kept",
      "createdAt": "5000000",
      "originEpochUs": "1759924158381000",
      "originUs": "4000000",
      "steps": [
        { "at": "5000000", "now": "1759924159381000" },
        { "at": "5000000", "fromSource": "4000000", "expect": "1759924158381000" }
      ]
    }
  ],
  "sampleTimelines": [
    {
      "name": "48 kHz anchored at the broadcast time it was created",
      "createdAt": "5000000",
      "originEpochUs": "1759924158381000",
      "timelineAt": "5020000",
      "sampleRate": "48000",
      "samples": [
        ["0", "1759924158401000"],
        ["1", "1759924158401020"],
        ["960", "1759924158421000"],
        ["47999", "1759924159400979"],
        ["48000", "1759924159401000"]
      ]
    },
    {
      "name": "44.1 kHz with an explicit first-sample time, exact past 2^53 sample-microseconds",
      "createdAt": "0",
      "originEpochUs": "1759924158381000",
      "timelineAt": "0",
      "sampleRate": "44100",
      "firstSampleUs": "1759924158381000",
      "samples": [
        ["1", "1759924158381022"],
        ["441", "1759924158391000"],
        ["15876000000", "1760284158381000"],
        ["15876000001", "1760284158381022"]
      ]
    }
  ],
  "sourceTimelines": [
    {
      "name": "a capture clock with its own origin is anchored at the broadcast time its first timestamp arrives",
      "createdAt": "5000000",
      "originEpochUs": "1759924158381000",
      "steps": [
        { "at": "5010000", "source": "123456789000", "expect": "1759924158391000" },
        { "at": "5090000", "source": "123456822333", "expect": "1759924158424333" },
        { "at": "5090000", "source": "123456788000", "expect": "1759924158390000" },
        { "at": "9000000", "source": "123456789000", "expect": "1759924158391000" }
      ]
    },
    {
      "name": "an uncalibrated timeline subtracts its capture latency from the anchored timestamp too",
      "createdAt": "5000000",
      "originEpochUs": "1759924158381000",
      "captureLatencyUs": "160000",
      "steps": [
        { "at": "5200000", "source": "7000", "expect": "1759924158421000" },
        { "at": "5300000", "source": "107000", "expect": "1759924158521000" }
      ]
    }
  ],
  "calibratedTimelines": [
    {
      "name": "measured pairs anchor, correct drift beyond the tolerance, and restart after a discontinuity",
      "createdAt": "0",
      "originEpochUs": "1759924158381000",
      "steps": [
        { "calibrate": "1000000", "calibrateAt": "10000", "expect": true },
        { "source": "1020000", "expect": "1759924158411000" },
        { "calibrate": "2000000", "calibrateAt": "1013000", "expect": false },
        { "source": "2000000", "expect": "1759924159391000" },
        { "calibrate": "3000000", "calibrateAt": "2015000", "expect": false },
        { "calibrate": "3000000", "calibrateAt": "2015001", "expect": true },
        { "source": "3000000", "expect": "1759924160396001" },
        { "calibrate": "0", "calibrateAt": "3000000", "expect": true },
        { "source": "20000", "expect": "1759924161401000" }
      ]
    },
    {
      "name": "a tolerance of zero follows every differing measurement",
      "createdAt": "0",
      "originEpochUs": "1759924158381000",
      "toleranceUs": "0",
      "steps": [
        { "calibrate": "0", "calibrateAt": "0", "expect": true },
        { "calibrate": "1000", "calibrateAt": "1000", "expect": false },
        { "calibrate": "2000", "calibrateAt": "2001", "expect": true },
        { "source": "3000", "expect": "1759924158384001" }
      ]
    },
    {
      "name": "a capture latency is subtracted from every timestamp, changes between timestamps, and leaves calibration alone",
      "createdAt": "0",
      "originEpochUs": "1759924158381000",
      "captureLatencyUs": "30000",
      "steps": [
        { "calibrate": "1000000", "calibrateAt": "10000", "expect": true },
        { "source": "1020000", "expect": "1759924158381000" },
        { "calibrate": "2000000", "calibrateAt": "1013000", "expect": false },
        { "captureLatency": "190000" },
        { "source": "2000000", "expect": "1759924159201000" },
        { "captureLatency": "0" },
        { "source": "2000000", "expect": "1759924159391000" }
      ]
    }
  ],
  "playout": [
    {
      "name": "the first frame anchors wall pacing; wait, show, the late boundary, then drop",
      "steps": [
        { "at": "1000", "mode": "idle", "position": null },
        { "at": "1000", "due": "5000000", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "1000", "mode": "wall", "position": "5000000" },
        { "at": "11000", "due": "5033333", "expect": { "action": "wait", "offsetUs": "23333", "waitUs": "23333" } },
        { "at": "34333", "due": "5033333", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "74333", "due": "5033333", "expect": { "action": "show", "offsetUs": "-40000" } },
        { "at": "74334", "due": "5033333", "expect": { "action": "drop", "offsetUs": "-40001" } }
      ]
    },
    {
      "name": "audio is the master and the clock extrapolates between reports",
      "steps": [
        { "at": "0", "report": "200000" },
        { "at": "0", "mode": "audio", "position": "200000" },
        { "at": "20000", "position": "220000" },
        { "at": "20000", "due": "250000", "expect": { "action": "wait", "offsetUs": "30000", "waitUs": "30000" } },
        { "at": "20000", "due": "220000", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "20000", "due": "180000", "expect": { "action": "show", "offsetUs": "-40000" } },
        { "at": "20000", "due": "179999", "expect": { "action": "drop", "offsetUs": "-40001" } },
        { "at": "30000", "report": "225000", "reportAt": "25000" },
        { "at": "30000", "mode": "audio", "position": "230000" },
        { "at": "30000", "due": "1230000", "expect": { "action": "wait", "offsetUs": "1000000", "waitUs": "1000000" } },
        { "at": "30000", "due": "1230001", "expect": { "action": "show", "offsetUs": "1000001" } },
        { "at": "30000", "mode": "audio", "position": "230000" },
        { "at": "30000", "due": "0", "expect": { "action": "drop", "offsetUs": "-230000" } }
      ]
    },
    {
      "name": "silent audio falls back to wall pacing without a jump, and a report takes over again",
      "steps": [
        { "at": "0", "report": "0" },
        { "at": "500000", "mode": "audio", "position": "500000" },
        { "at": "500001", "mode": "wall", "position": "500001" },
        { "at": "600000", "due": "600000", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "700000", "report": "650000" },
        { "at": "700000", "mode": "audio", "position": "650000" }
      ]
    },
    {
      "name": "silence is measured from when a report arrives, not from the moment it describes",
      "options": { "audioTimeoutUs": "50000" },
      "steps": [
        { "at": "100000", "report": "500000", "reportAt": "0" },
        { "at": "100000", "mode": "audio", "position": "600000" },
        { "at": "100000", "due": "500000", "expect": { "action": "drop", "offsetUs": "-100000" } },
        { "at": "150000", "mode": "audio", "position": "650000" },
        { "at": "150001", "mode": "wall", "position": "650001" }
      ]
    },
    {
      "name": "a step in output delay, as when switching to Bluetooth earbuds, holds video once and stays in sync",
      "steps": [
        { "at": "0", "report": "1000000" },
        { "at": "20000", "due": "1020000", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "40000", "report": "840000" },
        { "at": "40000", "due": "1040000", "expect": { "action": "wait", "offsetUs": "200000", "waitUs": "200000" } },
        { "at": "240000", "due": "1040000", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "273333", "due": "1073333", "expect": { "action": "show", "offsetUs": "0" } }
      ]
    },
    {
      "name": "stopping audio paces by wall clock from the current position",
      "steps": [
        { "at": "0", "stopAudio": true },
        { "at": "0", "mode": "idle", "position": null },
        { "at": "0", "report": "1000" },
        { "at": "100000", "stopAudio": true },
        { "at": "100000", "mode": "wall", "position": "101000" },
        { "at": "200000", "stopAudio": true },
        { "at": "200000", "mode": "wall", "position": "201000" },
        { "at": "200000", "due": "201000", "expect": { "action": "show", "offsetUs": "0" } }
      ]
    },
    {
      "name": "wall pacing re-anchors on a frame more than the maximum video delay early or the target latency late",
      "steps": [
        { "at": "0", "due": "0", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "0", "due": "1000000", "expect": { "action": "wait", "offsetUs": "1000000", "waitUs": "1000000" } },
        { "at": "0", "due": "1000001", "expect": { "action": "show", "offsetUs": "1000001" } },
        { "at": "10000", "mode": "wall", "position": "1010001" },
        { "at": "3010001", "due": "2010002", "expect": { "action": "drop", "offsetUs": "-2000000" } },
        { "at": "3010001", "position": "4010002" },
        { "at": "3010002", "due": "2010002", "expect": { "action": "show", "offsetUs": "-2000001" } },
        { "at": "3010002", "position": "2010002" },
        { "at": "3010002", "due": "1976669", "expect": { "action": "show", "offsetUs": "-33333" } },
        { "at": "3010002", "due": "1876669", "expect": { "action": "drop", "offsetUs": "-133333" } }
      ]
    },
    {
      "name": "reset returns to idle and the next frame anchors again",
      "steps": [
        { "at": "0", "report": "400000" },
        { "at": "10000", "reset": true },
        { "at": "10000", "mode": "idle", "position": null },
        { "at": "20000", "due": "7000", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "20000", "mode": "wall", "position": "7000" }
      ]
    },
    {
      "name": "options change every threshold",
      "options": { "lateDropUs": "0", "maxVideoDelayUs": "100000", "audioTimeoutUs": "1000" },
      "steps": [
        { "at": "0", "report": "0" },
        { "at": "1000", "mode": "audio", "position": "1000" },
        { "at": "1000", "due": "999", "expect": { "action": "drop", "offsetUs": "-1" } },
        { "at": "1000", "due": "101001", "expect": { "action": "show", "offsetUs": "100001" } },
        { "at": "1001", "mode": "wall", "position": "1001" },
        { "at": "1001", "due": "1001", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "1001", "due": "101001", "expect": { "action": "wait", "offsetUs": "100000", "waitUs": "100000" } },
        { "at": "1001", "due": "101002", "expect": { "action": "show", "offsetUs": "100001" } },
        { "at": "1001", "position": "101002" }
      ]
    },
    {
      "name": "the target latency is twice the longest of the last four keyframe intervals, 2 s before any, and survives a reset",
      "steps": [
        { "at": "0", "targetLatency": "2000000" },
        { "at": "0", "keyframeInterval": "1000000" },
        { "at": "0", "keyframeInterval": "300000" },
        { "at": "0", "targetLatency": "2000000" },
        { "at": "0", "keyframeInterval": "1500000" },
        { "at": "0", "targetLatency": "3000000" },
        { "at": "0", "keyframeInterval": "500000" },
        { "at": "0", "keyframeInterval": "500000" },
        { "at": "0", "keyframeInterval": "500000" },
        { "at": "0", "targetLatency": "3000000" },
        { "at": "0", "keyframeInterval": "500000" },
        { "at": "0", "targetLatency": "1000000" },
        { "at": "0", "reset": true },
        { "at": "0", "targetLatency": "1000000" },
        { "at": "0", "due": "0", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "1100000", "due": "100000", "expect": { "action": "drop", "offsetUs": "-1000000" } },
        { "at": "1100001", "due": "100000", "expect": { "action": "show", "offsetUs": "-1000001" } }
      ]
    },
    {
      "name": "an explicit target latency ignores keyframe intervals",
      "options": { "targetLatencyUs": "500000" },
      "steps": [
        { "at": "0", "keyframeInterval": "2000000" },
        { "at": "0", "targetLatency": "500000" },
        { "at": "0", "due": "0", "expect": { "action": "show", "offsetUs": "0" } },
        { "at": "600000", "due": "99999", "expect": { "action": "show", "offsetUs": "-500001" } },
        { "at": "600000", "position": "99999" }
      ]
    }
  ],
  "playoutErrors": [
    { "name": "a zero target latency", "options": { "targetLatencyUs": "0" } },
    { "name": "a negative target latency", "options": { "targetLatencyUs": "-1" } }
