  "epochOrigins": [
    { "name": "the default origin is the system clock at creation", "createdAt": "5000000", "systemClockMs": "1759924158381", "originEpochUs": "1759924158381000" },
    { "name": "an earlier origin is the system clock less the time since it", "createdAt": "5000000", "originUs": "4000000", "systemClockMs": "1759924158381", "originEpochUs": "1759924157381000" },
