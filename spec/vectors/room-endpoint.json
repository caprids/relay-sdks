{
  "source": "spec/behavior.md, \"Room-rooted endpoints\" and the Room row of the Arguments table; the refused fields follow spec/relay-interop.md, \"Endpoint paths\" (measured on moq-relay 0.17.5 and 0.17.0)",
  "note": "A case with `expected` returns exactly that URL string. A case with `error` throws: `type` is TypeError in both languages; `range` is RangeError in TypeScript and ValueError in Python. Endpoints here are written as both URL parsers serialize them (a lowercase host, no default port).",
  "cases": [
    { "name": "bare host", "endpoint": "https://relay.example", "room": ["acme", "rooms", "42"], "expected": "https://relay.example/acme/rooms/42" },
    { "name": "bare host with a trailing slash", "endpoint": "https://relay.example/", "room": ["acme"], "expected": "https://relay.example/acme" },
    { "name": "existing path", "endpoint": "https://relay.example/acme", "room": ["rooms", "42"], "expected": "https://relay.example/acme/rooms/42" },
    { "name": "existing path with a trailing slash", "endpoint": "https://relay.example/acme/", "room": ["rooms"], "expected": "https://relay.example/acme/rooms" },
    { "name": "existing path with several trailing slashes", "endpoint": "https://relay.example/acme//", "room": ["rooms"], "expected": "https://relay.example/acme/rooms" },
    { "name": "port kept", "endpoint": "https://relay.example:4443", "room": ["acme"], "expected": "https://relay.example:4443/acme" },
    { "name": "query kept", "endpoint": "https://relay.example/acme?region=ord&x=1", "room": ["rooms"], "expected": "https://relay.example/acme/rooms?region=ord&x=1" },
    { "name": "empty query kept", "endpoint": "https://relay.example/?", "room": ["acme"], "expected": "https://relay.example/acme?" },
    { "name": "jwt stays in the query", "endpoint": "https://relay.example?jwt=abc.def.ghi", "room": ["acme"], "expected": "https://relay.example/acme?jwt=abc.def.ghi" },
    { "name": "every allowed punctuation character", "endpoint": "https://relay.example", "room": ["a-._~!$&'()+,;=:@Z9"], "expected": "https://relay.example/a-._~!$&'()+,;=:@Z9" },
    { "name": "dots inside a field", "endpoint": "https://relay.example", "room": ["v1.2", "...", ".hidden"], "expected": "https://relay.example/v1.2/.../.hidden" },
    {
      "name": "32 fields",
      "endpoint": "https://relay.example",
      "room": [
        "f01", "f02", "f03", "f04", "f05", "f06", "f07", "f08",
        "f09", "f10", "f11", "f12", "f13", "f14", "f15", "f16",
