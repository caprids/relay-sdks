    { "name": "endpoint with a fragment", "endpoint": "https://relay.example#x", "room": ["acme"], "error": "range" },
    { "name": "endpoint with userinfo", "endpoint": "https://user@relay.example", "room": ["acme"], "error": "range" },
    { "name": "endpoint with an empty jwt", "endpoint": "https://relay.example?jwt=", "room": ["acme"], "error": "range" },
