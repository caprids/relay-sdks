      ],
      "expected": "https://relay.example/f01/f02/f03/f04/f05/f06/f07/f08/f09/f10/f11/f12/f13/f14/f15/f16/f17/f18/f19/f20/f21/f22/f23/f24/f25/f26/f27/f28/f29/f30/f31/f32"
    },
    { "name": "space in a field", "endpoint": "https://relay.example", "room": ["acme", "a b"], "error": "range" },
    { "name": "percent in a field", "endpoint": "https://relay.example", "room": ["acme", "a%b"], "error": "range" },
    { "name": "already percent-encoded field", "endpoint": "https://relay.example", "room": ["a%20b"], "error": "range" },
    { "name": "slash in a field", "endpoint": "https://relay.example", "room": ["acme", "rooms/42"], "error": "range" },
    { "name": "non-ASCII field", "endpoint": "https://relay.example", "room": ["café"], "error": "range" },
    { "name": "asterisk in a field", "endpoint": "https://relay.example", "room": ["a*b"], "error": "range" },
    { "name": "question mark in a field", "endpoint": "https://relay.example", "room": ["a?b"], "error": "range" },
    { "name": "hash in a field", "endpoint": "https://relay.example", "room": ["a#b"], "error": "range" },
    { "name": "backslash in a field", "endpoint": "https://relay.example", "room": ["a\\b"], "error": "range" },
    { "name": "control character in a field", "endpoint": "https://relay.example", "room": ["a\tb"], "error": "range" },
    { "name": "dot field", "endpoint": "https://relay.example", "room": ["acme", "."], "error": "range" },
    { "name": "dot-dot field", "endpoint": "https://relay.example", "room": [".."], "error": "range" },
    {
      "name": "33 fields",
      "endpoint": "https://relay.example",
      "room": [
        "f01", "f02", "f03", "f04", "f05", "f06", "f07", "f08",
        "f09", "f10", "f11", "f12", "f13", "f14", "f15", "f16",
