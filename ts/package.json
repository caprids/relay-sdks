{
  "name": "@mux/relay",
  "version": "0.0.0",
  "private": true,
  "description": "JavaScript SDK for Relay",
  "license": "UNLICENSED",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @mux/moq-core build && tsc -p tsconfig.build.json",
    "test": "pnpm --filter @mux/moq-core build && vitest run",
    "typecheck": "pnpm --filter @mux/moq-core build && tsc --noEmit -p tsconfig.json",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "check": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm check:boundaries",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:relay": "pnpm build && node scripts/test-relay.mjs",
    "example:mux-global": "pnpm build && node examples/mux-global/run.mjs"
  },
  "dependencies": {
    "@mux/moq-core": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "24.12.2",
    "playwright": "1.59.1",
    "typescript": "6.0.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
