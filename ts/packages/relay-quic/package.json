{
  "name": "@caprid/relay-quic",
  "version": "0.3.0",
  "description": "Native QUIC transport adapter for the Relay SDK in Node",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caprids/relay-sdks.git",
    "directory": "ts/packages/relay-quic"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:native": "napi build --platform --release --manifest-path native/Cargo.toml --output-dir native --no-js --dts ../src/native.d.ts"
  },
  "napi": {
    "binaryName": "relay-quic",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-apple-darwin",
      "x86_64-apple-darwin",
      "x86_64-pc-windows-msvc"
    ]
  },
  "dependencies": {
    "@caprid/moq-core": "workspace:*"
  },
  "devDependencies": {
    "@napi-rs/cli": "3.10.5",
    "@types/node": "24.12.2"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
